---
import Base from "@/layouts/Base.astro";
import TopBar from "@/components/TopBar.astro";
import Hero from "@/components/Hero.astro";
import StatTiles from "@/components/StatTiles.astro";
import Services from "@/components/Services.astro";
import EventLog from "@/components/EventLog.astro";
import { getSiteData } from "@/lib/site";

const { profile, stats, projects, events } = await getSiteData();
---

<Base title="Himanshu Singh — Software Engineer" description={profile.intro} path="/">
  <TopBar slot="header" status={profile.status} />
  <section class="wrap overview" aria-labelledby="hero-title">
    <Hero headline={profile.headline} intro={profile.intro} resumeUrl={profile.resumeUrl} />
    <StatTiles stats={stats} />
  </section>
  <section class="wrap panels" aria-label="Services and event log">
    <Services projects={projects} />
    <EventLog events={events} />
  </section>
</Base>

<style>
  .panels {
    display: grid;
    gap: 16px;
    padding-bottom: 64px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .panels {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }
  .overview {
    display: grid;
    gap: 32px;
    padding-block: 48px 40px;
  }
  @media (min-width: 900px) {
    .overview {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 56px;
      align-items: center;
      padding-block: 88px 64px;
    }
  }
</style>
