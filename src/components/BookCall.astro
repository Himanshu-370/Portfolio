---
interface Props {
  calLink: string | null;
  linkedinUrl: string | undefined;
}

const { calLink, linkedinUrl } = Astro.props;

const calScript = `(function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
var el = document.getElementById("cal-embed");
var link = el && el.getAttribute("data-cal-link");
if (link) {
  Cal("init", { origin: "https://app.cal.com" });
  var current = null;
  // Cal.com picks the frame theme from ui.color-scheme (else the OS setting) when the
  // frame loads, so pass it explicitly and re-render on toggle instead of restyling live.
  var render = function (theme) {
    if (theme === current) return;
    current = theme;
    el.replaceChildren();
    el.style.colorScheme = theme;
    Cal("inline", {
      elementOrSelector: "#cal-embed",
      calLink: link,
      layout: "month_view",
      config: { layout: "month_view", theme: theme, "ui.color-scheme": theme },
    });
    Cal("ui", {
      theme: theme,
      layout: "month_view",
      hideEventTypeDetails: false,
      styles: { body: { background: "transparent" } },
      cssVarsPerTheme: {
        light: { "cal-brand": "#151515", "cal-bg": "transparent", "cal-bg-muted": "#f7f7f5" },
        dark: { "cal-brand": "#ededea", "cal-bg": "transparent", "cal-bg-muted": "#171716" },
      },
    });
  };
  // Follows the site theme (html[data-theme], set before paint in Base.astro).
  render(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
  window.addEventListener("themechange", function (e) {
    render(e.detail === "dark" ? "dark" : "light");
  });
}`;
---

<section class="wrap book" id="book" aria-labelledby="book-title">
  <div class="card">
    <h2 class="label" id="book-title">Book a call</h2>
    <p class="line">30-minute intro over Google Meet.</p>
    {
      calLink ? (
        <div id="cal-embed" class="embed" data-cal-link={calLink} />
      ) : (
        <div class="fallback">
          <p class="muted">Booking opens soon</p>
          {linkedinUrl && (
            <a class="btn" href={linkedinUrl} target="_blank" rel="me noopener">
              Message me on LinkedIn ↗
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

{calLink && <script is:inline set:html={calScript} />}

<style>
  .book {
    padding-bottom: 48px;
  }
  .line {
    margin: 0 0 14px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .fallback p {
    margin: 0 0 12px;
    font-size: 14px;
  }
  .embed {
    min-height: 480px;
    width: 100%;
    overflow: auto;
  }
</style>
