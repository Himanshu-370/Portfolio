---
import type { LogEvent } from "@/lib/events";

interface Props {
  events: LogEvent[];
}

const { events } = Astro.props;
const chips = [
  { id: "all", label: "all" },
  { id: "MERGED", label: "merged" },
  { id: "OPEN", label: "open" },
  { id: "RELEASE", label: "releases" },
] as const;
const cls = { MERGED: "lv-merged", OPEN: "lv-open", RELEASE: "lv-release" } as const;
---

<section class="card events" aria-labelledby="events-title">
  <div class="head">
    <h2 class="label" id="events-title">Event log</h2>
    <div class="seg" role="group" aria-label="Event kind" data-kinds>
      {
        chips.map((c) => (
          <button type="button" data-kind={c.id} aria-pressed={c.id === "all" ? "true" : "false"}>
            {c.label}
          </button>
        ))
      }
    </div>
  </div>
  <div class="scroller" tabindex="-1">
    <ul class="list" data-events>
      {
        events.map((e, i) => (
          <li data-index={i} data-date={e.date} data-level={e.level}>
            <a class="row ev" href={e.url} target="_blank" rel="noopener">
              <span class="date mono muted">{e.date.slice(0, 10)}</span>
              <span class={`lv ${cls[e.level]}`}>{e.level}</span>
              <span class="repo">{e.repo}</span>
              <span class="title">{e.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty muted" data-empty hidden>No events in this range</p>
  </div>
  <script id="event-data" type="application/json" set:html={JSON.stringify(events).replace(/</g, "\\u003c")} />
</section>

<script>
  import "@/scripts/event-log";
</script>

<style>
  .events {
    min-width: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    margin-bottom: 6px;
  }
  .head .label {
    margin: 0;
  }
  .scroller {
    max-height: 420px;
    overflow-y: auto;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li[hidden] {
    display: none;
  }
  .ev {
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    padding: 8px 4px;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .ev:hover {
    background: var(--bg);
  }
  .date {
    font-size: 12px;
    white-space: nowrap;
  }
  .repo {
    font-weight: 600;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .title {
    flex-basis: 100%;
    min-width: 0;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .empty {
    margin: 0;
    padding: 16px 0;
    font-size: 13px;
  }
  .empty[hidden] {
    display: none;
  }
  @media (min-width: 600px) {
    .ev {
      flex-wrap: nowrap;
    }
    .repo {
      flex: none;
      max-width: 40%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .title {
      flex: 1 1 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
