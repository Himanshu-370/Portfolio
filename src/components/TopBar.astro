---
interface Props {
  status?: string;
}

const { status } = Astro.props;
const ranges = [
  { id: "30d", label: "30d" },
  { id: "1y", label: "1y" },
  { id: "all", label: "all" },
] as const;
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="wordmark mono" href="/">himanshu-singh <span class="muted">/ prod</span></a>
    {
      status !== undefined && (
    <div class="topbar-controls">
      <div class="seg" role="group" aria-label="Time range">
        {
          ranges.map((r) => (
            <button type="button" data-range={r.id} aria-pressed={r.id === "all" ? "true" : "false"}>
              {r.label}
            </button>
          ))
        }
      </div>
      <span class="pill">
        <span class="dot" aria-hidden="true"></span>
        healthy <span class="muted">·</span>
        {status}
      </span>
    </div>
      )
    }
    <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch theme" title="Switch theme">
      <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
  </div>
</header>

<script>
  import "@/scripts/theme-toggle";
</script>

<style>
  .topbar {
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-block: 14px;
  }
  .wordmark {
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }
  .wordmark .muted {
    font-weight: 500;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--ease);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  /* Phones: keep the toggle on the wordmark's row; controls wrap below. */
  @media (max-width: 599px) {
    .theme-toggle {
      order: 1;
    }
    .topbar-controls {
      order: 2;
    }
  }
  .theme-toggle:hover {
    border-color: var(--line-strong);
  }
  /* Show the icon of the theme you would switch to. */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }
  .topbar-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
</style>
