---
interface Props {
  headline: { lead: string; tail: string; rotating: string[] };
  intro: string;
  resumeUrl: string;
}

const { headline, intro, resumeUrl } = Astro.props;
const phrases = [headline.tail, ...headline.rotating];
const phrasesJson = JSON.stringify(phrases).replace(/</g, "\\u003c");
---

<div class="hero">
  <h1 id="hero-title" class="headline hero-title">
    {headline.lead}
    {/* Screen readers get one stable sentence; the animated copy below is decorative. */}
    <span class="sr-only">{headline.tail}</span>
    <span class="term" aria-hidden="true">
      {/* Invisible copies of every phrase reserve the tallest height, so typing never shifts the layout. */}
      {
        phrases.map((p) => (
          <span class="term-line ghost">
            <span class="prompt">$ </span>
            {p}
            <span class="caret" />
          </span>
        ))
      }
      <span class="term-line live">
        <span class="prompt">$ </span><span data-typewriter>{headline.tail}</span><span class="caret" />
      </span>
    </span>
  </h1>
  <p class="hero-intro">{intro}</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="#book">Let's talk <span aria-hidden="true">→</span></a>
    <a class="btn" href={resumeUrl}>Résumé</a>
  </div>
</div>

<script type="application/json" id="typewriter-data" set:html={phrasesJson} />

<script>
  import "@/scripts/typewriter";
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .hero-title {
    font-size: clamp(34px, 5.2vw, 52px);
    max-width: 18ch;
  }
  .term {
    display: grid;
    margin-top: 0.12em;
    font-family: var(--font-mono);
    font-size: 0.74em;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .term-line {
    grid-area: 1 / 1;
  }
  .term-line.ghost {
    visibility: hidden;
  }
  .headline .prompt {
    color: var(--merged);
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 0.95em;
    margin-left: 0.08em;
    vertical-align: -0.12em;
    background: var(--tail);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
  .hero-intro {
    margin: 0;
    max-width: 52ch;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
</style>
