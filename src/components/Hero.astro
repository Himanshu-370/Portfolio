---
interface Props {
  headline: { lead: string; tail: string };
  intro: string;
  resumeUrl: string;
}

const { headline, intro, resumeUrl } = Astro.props;
---

<div class="hero">
  <h1 id="hero-title" class="headline hero-title">
    {headline.lead}{" "}<span>{headline.tail}</span>
  </h1>
  <p class="hero-intro">{intro}</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="#book">Let's talk <span aria-hidden="true">→</span></a>
    <a class="btn" href={resumeUrl}>Résumé</a>
  </div>
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .hero-title {
    font-size: clamp(34px, 5.2vw, 52px);
    max-width: 15ch;
  }
  .hero-intro {
    margin: 0;
    max-width: 52ch;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
</style>
